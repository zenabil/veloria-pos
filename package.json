{
  "name": "veloria-pos",
  "productName": "Veloria PoS",
  "version": "2.0.0",
  "description": "Veloria PoS — Professional Offline-First Retail POS (Windows Desktop, French, DZD)",
  "author": "Veloria",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run build:electron && electron .",
    "build": "tsc -b && vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/release/stamp-electron-pkg.js",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run tests/database tests/integration",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3 || echo \"native rebuild skipped - run npm run rebuild after installing build tools\"",
    "package": "npm run build && npm run build:electron && electron-builder",
    "package:win": "npm run build && npm run build:electron && electron-builder --win",
    "package:portable": "npm run build && npm run build:electron && electron-builder --win portable",
    "release:smoke": "node scripts/release/smoke.js",
    "db:migrate": "node scripts/database/migrate.js",
    "db:integrity": "node scripts/database/integrity.js"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.5",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-select": "2.1.5",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-toast": "1.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.469.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "7.54.2",
    "recharts": "2.15.0",
    "better-sqlite3": "12.2.0",
    "bindings": "1.5.0",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.1",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "4.0.1",
    "@playwright/test": "1.49.1",
    "@tailwindcss/vite": "4.1.5",
    "@types/node": "22.10.5",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "electron": "37.2.0",
    "electron-builder": "26.0.12",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "3.4.2",
    "tailwindcss": "4.1.5",
    "typescript": "5.7.3",
    "typescript-eslint": "8.19.1",
    "vite": "6.0.7",
    "vitest": "3.1.1",
    "wait-on": "8.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
