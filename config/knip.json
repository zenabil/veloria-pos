{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "electron/preload/preload.ts",
        "license-manager/main/main.ts",
        "license-manager/renderer/manager-env.d.ts",
        "cloud/supabase/functions/**/index.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx,css}",
        "electron/**/*.ts",
        "tests/**/*.{ts,tsx}",
        "license-manager/**/*.{ts,tsx}",
        "cloud/**/*.ts"
      ],
      "ignoreExportsUsedInFile": true,
      "ignoreBinaries": ["net"]
    },
    "mobile": {
      "entry": ["src/App.tsx"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreExportsUsedInFile": true,
      "ignoreBinaries": ["eas"],
      "ignoreDependencies": ["expo-updates"]
    },
    "owner": {
      "entry": ["src/App.tsx"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreExportsUsedInFile": true,
      "ignoreDependencies": ["expo-updates", "react-native-web"]
    }
  }
}
