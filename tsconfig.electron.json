{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "CommonJS",
    // node10 reste requis pour l'émission CommonJS de main/preload ; TypeScript 7
    // (bloqué par typescript-eslint <6.1) imposera une migration node16.
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "dist-electron",
    "rootDir": "electron",
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/electron.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["electron/**/*.ts"]
}
