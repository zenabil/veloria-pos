{
  "expo": {
    "name": "Veloria Client",
    "slug": "veloria-client",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/brand/veloria-customer.png",
    "splash": {
      "image": "./assets/brand/veloria-customer.png",
      "resizeMode": "contain",
      "backgroundColor": "#051424"
    },
    "locales": {
      "ar": "./locales/ar.json",
      "fr": "./locales/fr.json"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/Ionicons.ttf"]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scannez le QR d'activation de votre magasin. امسح رمز التفعيل الخاص بمحلك.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "android": {
      "package": "dz.veloria.client",
      "permissions": ["CAMERA"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/veloria-customer-foreground.png",
        "backgroundColor": "#051424"
      }
    },
    "ios": {
      "infoPlist": {
        "NSCameraUsageDescription": "Scannez le QR d'activation de votre magasin. امسح رمز التفعيل الخاص بمحلك."
      }
    }
  }
}
