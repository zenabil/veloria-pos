{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    // expo/tsconfig.base utilise encore node10 ; TS 7 (bloqué) imposera la migration.
    "ignoreDeprecations": "6.0"
  },
  "include": ["src"]
}
