{
  "name": "veloria-client",
  "version": "1.0.0",
  "private": true,
  "description": "Veloria Client — APK lecture seule (dettes + factures), ar/fr, 0 $",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "build:apk": "node scripts/validate-env.mjs && eas build -p android --profile preview",
    "validate-env": "node scripts/validate-env.mjs",
    "typecheck": "node ../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node scripts/validate-env.mjs --env-only",
    "lint": "node ../node_modules/eslint/bin/eslint.js src --max-warnings 0",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "~14.0.4",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-camera": "~16.0.18",
    "expo-constants": "~17.0.8",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-linear-gradient": "~14.0.2",
    "expo-secure-store": "~14.0.0",
    "expo-sqlite": "~15.0.0",
    "react": "18.3.1",
    "react-native": "0.76.0",
    "react-native-web": "~0.19.13"
  }
}
