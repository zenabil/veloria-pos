# Veloria PoS — ignores
node_modules/
dist/
dist-electron/
dist-license-manager/
dist-license-manager-renderer/
release/
out/
*.log
logs/

# Electron / native
*.node

# OS
.DS_Store
Thumbs.db
desktop.ini

# Env / secrets
.env
.env.*
!.env.example

# Licensing — vendor private keys & customer licenses (NEVER commit)
private/
*.vlic
license-manager/*.sqlite
license-manager/*.sqlite-wal
license-manager/*.sqlite-shm

# User data (never commit a real POS database)
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.vposdb
!database/migrations/*.sql

# Backups
backups/
*.zip
*.7z
*.rar

# IDE
.vscode/*
!.vscode/extensions.json
.idea/

# Test / coverage
coverage/
playwright-report/
test-results/
*.tsbuildinfo
