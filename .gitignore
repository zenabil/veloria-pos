# Veloria PoS — ignores
node_modules/
# Outillage vivant (jamais committé, jamais déplacé : adresses stables).
.opencode/
# Rapports de maintenance historisés sous docs/reports/maintenance/ (#38) :
# toute recréation à la racine est ignorée.
maintenance-reports/
dist/
dist-electron/
dist-license-manager/
dist-license-manager-renderer/
# ancré (« / » initial) : sans lui git ignorait TOUT dossier nommé « release »
# à toute profondeur — dont scripts/release/ (stamp/checksums/smoke), donc un
# clone/CI ne trouvait plus stamp-electron-pkg.js (build:electron en échec).
/release/
out/
*.log
logs/
# Trace de build GÉNÉRÉE (REL-04) : écrite à chaque build par
# `npm run release:stamp-build-info`, embarquée dans l'artefact via
# extraResources. Un clone/CI la régénère — elle ne doit JAMAIS être commitée
# (elle est datée et propre à une machine de build).
scripts/release/build-info.json

# Electron / native
*.node

# OS
.DS_Store
Thumbs.db
desktop.ini

# Env / secrets
.env
.env.*
!.env.example

# Licensing — vendor private keys & customer licenses (NEVER commit)
private/
*.vlic
license-manager/*.sqlite
license-manager/*.sqlite-wal
license-manager/*.sqlite-shm

# User data (never commit a real POS database)
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.vposdb
!database/migrations/*.sql

# Backups
backups/
*.zip
*.7z
*.rar

# IDE
.vscode/*
!.vscode/extensions.json
.idea/

# Test / coverage
coverage/
playwright-report/
test-results/
*.tsbuildinfo
# Graphe généré (hooks) — jamais committé, régénérable via `graphify update .`.
graphify-out/
# Scratch local (audits/sessions) — jamais committé
check_like.py
full-inventory.txt
# Expo local (jamais committé)
.expo/
mobile/android/
mobile/ios/
mobile/dist-web/
owner/android/
owner/ios/
owner/.expo/
*.keystore
*.jks
local.properties

# Scratch electron-builder du License Manager (régénéré par package:manager ;
# un app.asar peut y rester verrouillé par le scanneur après une build).
# /release-mgr/ = même symptôme, répertoire de repli utilisé quand `release/`
# est verrouillé en pleine build (sortie hors workspace puis copie).
/release-manager-tmp/
/release-mgr/

# Captures du site vitrine : artefacts régénérés par `npm run verify:site` (docs/shots/site/).
docs/shots/site/

# Artefacts de l'outil navigateur (MCP Playwright) : jamais dans le d�p�t.
.playwright-mcp/
