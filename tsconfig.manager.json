{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    // Même contrainte que tsconfig.electron.json (émission CommonJS du Manager).
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist-license-manager",
    "rootDir": ".",
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/manager.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "license-manager/main/**/*.ts",
    "license-manager/preload/**/*.ts",
    "license-manager/ipc/**/*.ts",
    "license-manager/db/**/*.ts",
    "license-manager/signing.ts",
    "license-manager/renderer/**/*.tsx",
    "license-manager/renderer/**/*.ts",
    "src/shared/errors/fr-map.ts",
    "src/shared/dates/dates.ts",
    "electron/licensing/protocol.ts",
    "electron/licensing/catalog.ts",
    "electron/licensing/fingerprint.ts",
    "electron/licensing/hash.ts"
  ]
}
